# Variables d'environnement pour le serveur MLflow et sa base de données PostgreSQL.
# Ces valeurs sont utilisées dans docker-compose.yml via la directive env_file.

POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow_secret
POSTGRES_DB=mlflow_db
POSTGRES_PORT=5432

MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:mlflow_secret@postgres:5432/mlflow_db
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000
